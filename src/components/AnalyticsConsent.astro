---
import { site } from '../data/site';
---
{site.gaId && (
  <div class="consent" data-analytics-consent data-ga-id={site.gaId} role="region" aria-label="Analytics choice" hidden>
    <div class="wrap inner">
      <p>
        May we count visits with Google Analytics? It sets cookies. Nothing is loaded from Google unless you say yes.
        <a class="text-link" href="/privacy/">Privacy policy</a>
      </p>
      <div class="actions">
        <button type="button" class="btn" data-analytics-choice="granted">Allow analytics</button>
        <button type="button" class="btn btn-quiet" data-analytics-choice="denied">No thanks</button>
      </div>
    </div>
  </div>
)}

<style>
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--panel);
    border-top: 1px solid var(--line);
    box-shadow: 0 -2px 12px rgba(28, 38, 51, 0.08);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .consent[hidden] {
    display: none;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    .inner {
      flex-direction: column;
      align-items: stretch;
    }
    .actions .btn {
      flex: 1;
    }
  }
</style>

<script>
  // Google Analytics loads only after the visitor allows it. The choice is kept in this browser.
  const root = document.querySelector<HTMLElement>('[data-analytics-consent]');
  if (root) {
    const id = root.dataset.gaId ?? '';
    const KEY = 'hv-analytics';
    const w = window as any;

    const read = () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };
    const write = (value: string) => {
      try {
        localStorage.setItem(KEY, value);
      } catch {
        /* storage blocked: the choice is only kept until the page closes */
      }
    };

    let loaded = false;
    const load = () => {
      w[`ga-disable-${id}`] = false;
      if (loaded) return;
      loaded = true;
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () {
        // gtag.js expects the arguments object itself, not an array
        // eslint-disable-next-line prefer-rest-params
        w.dataLayer.push(arguments);
      };
      w.gtag('js', new Date());
      w.gtag('config', id);
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
      document.head.appendChild(s);
    };

    const stop = () => {
      w[`ga-disable-${id}`] = true;
      const past = 'Thu, 01 Jan 1970 00:00:00 GMT';
      const names = ['_ga', '_ga_' + id.replace(/^G-/, '')];
      const host = location.hostname;
      const domains = ['', `; domain=${host}`, `; domain=.${host.replace(/^www\./, '')}`];
      for (const name of names) {
        for (const d of domains) document.cookie = `${name}=; expires=${past}; path=/${d}`;
      }
    };

    let opener: HTMLElement | null = null;
    const show = () => {
      root.hidden = false;
      root.querySelector<HTMLElement>('[data-analytics-choice="granted"]')?.focus();
    };
    const hide = () => {
      root.hidden = true;
      opener?.focus();
      opener = null;
    };

    for (const button of root.querySelectorAll<HTMLElement>('[data-analytics-choice]')) {
      button.addEventListener('click', () => {
        const choice = button.dataset.analyticsChoice === 'granted' ? 'granted' : 'denied';
        write(choice);
        if (choice === 'granted') load();
        else stop();
        hide();
      });
    }

    for (const link of document.querySelectorAll<HTMLElement>('[data-analytics-settings]')) {
      link.addEventListener('click', () => {
        opener = link;
        show();
      });
    }

    const saved = read();
    if (saved === 'granted') load();
    else if (saved !== 'denied') root.hidden = false;
  }
</script>
