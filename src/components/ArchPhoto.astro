---
// A view photo inside an arched window frame. Until a licensed photo has been downloaded
// (scripts/fetch-photos.mjs), the window shows a plain sky with the landmark name, so nothing looks broken.
import type { Photo } from '../lib/views';

interface Props {
  photo: Photo | null;
  landmark: string;
  variant?: 'hero' | 'thumb';
  credit?: boolean;
  eager?: boolean;
}

const { photo, landmark, variant = 'hero', credit = false, eager = false } = Astro.props;
const sizes = variant === 'hero' ? '(max-width: 760px) 100vw, 440px' : '(max-width: 760px) 100vw, 340px';
---
<figure class:list={['arch', variant]}>
  <div class="frame">
    {photo ? (
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        style={photo.position ? `object-position: ${photo.position}` : undefined}
      />
    ) : (
      <div class="sky" aria-hidden="true">
        <span class="sun"></span>
        <span class="horizon"></span>
        <span class="name">{landmark}</span>
      </div>
    )}
  </div>
  {credit && photo && (
    <figcaption class="small">
      Photo: {photo.author}, <a class="text-link" href={photo.licenseUrl ?? photo.source} rel="noopener">{photo.license}</a>, via <a class="text-link" href={photo.source} rel="noopener">Wikimedia Commons</a>
    </figcaption>
  )}
</figure>

<style>
  .arch {
    margin: 0;
  }
  /* Portrait 4:5 window. Vertical radius 40% of the height = half of the width, so the top is a true semicircle. */
  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 50% 50% var(--radius) var(--radius) / 40% 40% var(--radius) var(--radius);
    background: var(--sky);
    box-shadow: inset 0 0 0 1px rgba(28, 38, 51, 0.08);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #b9cddd 0%, #dbe5ed 58%, #ead9bd 100%);
  }
  .sun {
    position: absolute;
    width: 13%;
    aspect-ratio: 1;
    left: 58%;
    top: 44%;
    border-radius: 50%;
    background: var(--brass);
  }
  .horizon {
    position: absolute;
    left: 0;
    right: 0;
    top: 66%;
    height: 1px;
    background: rgba(28, 38, 51, 0.35);
  }
  .name {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 9%;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 560;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    line-height: 1.1;
    color: var(--ink);
    text-align: center;
  }
  .thumb .name {
    font-size: 1.25rem;
  }
  figcaption {
    margin-top: 10px;
  }
  /* On phones the window gets wider and lower, so the hotels list is not pushed far down. */
  @media (max-width: 860px) {
    .hero .frame {
      aspect-ratio: 4 / 3;
      border-radius: 50% 50% var(--radius) var(--radius) / 28% 28% var(--radius) var(--radius);
    }
  }
  figcaption a {
    color: var(--zinc);
  }
</style>
