---
// Pairs of room-name phrases that look alike but don't mean the same view.
interface Props {
  heading?: string;
  intro?: string;
  pairs: { left: string; right: string; text: string; where?: string }[];
}

const { heading = 'Read the small print in the room name', intro, pairs } = Astro.props;
---
<section class="decoder" aria-labelledby="decoder-heading">
  <h2 id="decoder-heading">{heading}</h2>
  {intro && <p class="intro measure">{intro}</p>}
  <dl>
    {pairs.map((p) => (
      <div class="pair">
        <dt>
          <span class="phrase">{p.left}</span>
          <span class="ne" aria-hidden="true">≠</span>
          <span class="visually-hidden"> is not </span>
          <span class="phrase">{p.right}</span>
        </dt>
        <dd>
          {p.text}
          {p.where && <a class="text-link" href={p.where}>See the rooms</a>}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .decoder {
    margin-top: 72px;
  }
  .intro {
    margin-top: 10px;
    color: var(--ink-soft);
  }
  dl {
    margin: 24px 0 0;
    border-top: 1px solid var(--line);
  }
  /* One row per pair: the two phrases on the left, what it means on the right. */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 8px 40px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 560;
    font-size: 1.5rem;
    line-height: 1.2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 12px;
  }
  .ne {
    color: var(--brass);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
  }
  dd {
    margin: 0;
    color: var(--ink-soft);
    max-width: 60ch;
    align-self: center;
  }
  dd a {
    display: inline-block;
    margin-left: 6px;
  }
  @media (max-width: 760px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
    dt {
      font-size: 1.3125rem;
    }
  }
</style>
