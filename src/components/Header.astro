---
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/views/', label: 'Views' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/about/#how-we-check', label: 'How we check' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href: string) => href !== '/about/#how-we-check' && path.startsWith(href);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="home" href="/" aria-label="HotelsViewer home">
      <Logo />
    </a>
    <nav aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .home {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
</style>
