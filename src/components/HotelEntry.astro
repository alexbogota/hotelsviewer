---
import LevelPill from './LevelPill.astro';
import { goHref, monthLabel, pricesButton, starsLabel, type Hotel } from '../lib/views';
import { site } from '../data/site';

interface Props {
  hotel: Hotel;
  checked: string;
  n: number;
  city: string;
  country: string;
  campaign: string;
}

const { hotel, checked, n, city, country, campaign } = Astro.props;

// Stay22 list centred on the hotel's own address at the closest zoom: the first card is this hotel, with its photos and prices
// (owner checked Arc de Triomphe and Eiffel Tower on /lab/hotel-photos/, 19 Oct 2026). City and country are added when the address lacks them.
const has = (t: string) => hotel.where.toLowerCase().includes(t.toLowerCase());
const address = [hotel.where, has(city) ? '' : city, has(country) ? '' : country].filter(Boolean).join(', ');
const photosSrc = site.stay22Aid
  ? `https://www.stay22.com/embed/gm?${new URLSearchParams({
      aid: site.stay22Aid,
      address,
      zoom: '18',
      viewmode: 'listview',
      limit: '5',
      campaign,
      maincolor: '1c2633',
    }).toString()}`
  : '';
const facts = [hotel.distance, starsLabel(hotel.stars)].filter(Boolean).join(', ');

// "a, b and c" with official sources linked.
const sources = hotel.sources;
const lastIndex = sources.length - 1;
---
<article class="hotel" id={hotel.id} aria-labelledby={`${hotel.id}-name`}>
  <header class="head">
    <p class="num" aria-hidden="true">{n}</p>
    <div class="who">
      <h3 id={`${hotel.id}-name`}>{hotel.name}</h3>
      <p class="where">
        {hotel.where}{facts && <><br /><span class="facts">{facts.charAt(0).toUpperCase() + facts.slice(1)}</span></>}
      </p>
      <LevelPill level={hotel.level} />
    </div>
  </header>

  <div class="body">
    <section class="book" aria-label={`Rooms to book at ${hotel.name}`}>
      <h4>Book one of these</h4>
      <ul>
        {hotel.book.map((r) => (
          <li>
            <p class="room">{r.room}</p>
            {r.note && <p class="note">{r.note}</p>}
          </li>
        ))}
      </ul>
      <a class="btn" href={goHref(hotel.id)} rel="sponsored nofollow noopener" target="_blank">{pricesButton}</a>
    </section>

    {photosSrc && (
      <div class="photos">
        <p class="small">Photos and prices from our partner Stay22, around this address. Bookings made here may earn us a commission.</p>
        <iframe src={photosSrc} title={`Photos and prices for ${hotel.name}, from Stay22`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    )}

    {hotel.skip && hotel.skip.length > 0 && (
      <details class="skip">
        <summary>Not these ({hotel.skip.length}): look-alike rooms</summary>
        <ul>
          {hotel.skip.map((r) => (
            <li>
              <p class="room">{r.room}</p>
              {r.note && <p class="note">{r.note}</p>}
            </li>
          ))}
        </ul>
      </details>
    )}

    {hotel.notes && hotel.notes.length > 0 && (
      <div class="notes">
        {hotel.notes.map((n) => <p>{n}</p>)}
      </div>
    )}

    <p class="small sources">
      Sources:{' '}
      {sources.map((s, i) => (
        <>
          {s.url ? <a class="text-link" href={s.url} rel="noopener">{s.label}</a> : s.label}
          {i < lastIndex - 1 ? ', ' : i === lastIndex - 1 ? ' and ' : ''}
        </>
      ))}. Checked {monthLabel(checked)}.
    </p>
  </div>
</article>

<style>
  .hotel {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 20px 48px;
    padding: 36px 0 40px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 16px;
  }
  .head {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .num {
    flex: none;
    width: 40px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px 20px 4px 4px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .who h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
  }
  .where {
    margin: 8px 0 14px;
    color: var(--ink-soft);
  }
  .facts {
    color: var(--zinc);
  }
  .book {
    padding: 22px 24px 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  h4 {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--zinc);
    margin-bottom: 12px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .book li {
    padding-left: 14px;
    border-left: 3px solid var(--brass);
  }
  .book .room {
    font-size: 1.375rem;
  }
  .book .btn {
    margin-top: 22px;
  }
  .photos {
    margin-top: 18px;
  }
  .photos iframe {
    display: block;
    width: 100%;
    height: 460px;
    margin-top: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky);
  }
  .skip {
    margin-top: 16px;
  }
  .skip summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--zinc);
  }
  .skip ul {
    margin-top: 6px;
  }
  .skip li {
    padding-left: 14px;
    border-left: 3px solid var(--line);
  }
  .skip .room {
    color: var(--ink-soft);
    font-weight: 460;
  }
  .note {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--zinc);
    max-width: 62ch;
  }
  .notes {
    margin-top: 16px;
    max-width: 66ch;
    color: var(--ink-soft);
  }
  .notes p + p {
    margin-top: 8px;
  }
  .sources {
    margin-top: 16px;
    max-width: 66ch;
  }
  @media (max-width: 860px) {
    .hotel {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 760px) {
    .book {
      padding: 18px 16px 20px;
    }
    .book .btn {
      width: 100%;
    }
  }
</style>
