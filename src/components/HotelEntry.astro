---
import LevelPill from './LevelPill.astro';
import { goHref, monthLabel, pricesButton, starsLabel, type Hotel } from '../lib/views';
import hotelPhotos from '../data/hotel-photos.json';

interface Props {
  hotel: Hotel;
  checked: string;
}

const { hotel, checked } = Astro.props;
// A licensed photo from Wikimedia Commons, chosen by eye (src/data/hotel-photos.json, files in public/photos/hotels/).
const photo = (hotelPhotos as Record<string, { src: string; alt: string; width: number; height: number; author: string; license: string; source: string; fromHotel: boolean }>)[hotel.id];
const facts = [hotel.distance, starsLabel(hotel.stars)].filter(Boolean).join(', ');

// "a, b and c" with official sources linked.
const sources = hotel.sources;
const lastIndex = sources.length - 1;
---
<article class="hotel" id={hotel.id} aria-labelledby={`${hotel.id}-name`}>
  <div class:list={['top', { 'has-photo': photo }]}>
    {photo && (
      <figure class="shot">
        <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
        <figcaption class="small">
          {photo.fromHotel && <><strong>Taken from the hotel.</strong> </>}
          Photo: {photo.author}, <a class="text-link" href={photo.source} rel="noopener">{photo.license}</a>, via Wikimedia Commons
        </figcaption>
      </figure>
    )}
    <div class="intro-text">
      <header class="head">
        <h3 id={`${hotel.id}-name`}>{hotel.name}</h3>
        <LevelPill level={hotel.level} />
      </header>
      <p class="where">
        {hotel.where}{facts && <><br /><span class="facts">{facts.charAt(0).toUpperCase() + facts.slice(1)}</span></>}
      </p>
    </div>
  </div>

  <div class="lists">
    <section class="book" aria-label={`Rooms to book at ${hotel.name}`}>
      <h4>Book one of these</h4>
      <ul>
        {hotel.book.map((r) => (
          <li>
            <p class="room">{r.room}</p>
            {r.note && <p class="note">{r.note}</p>}
          </li>
        ))}
      </ul>
    </section>

    {hotel.skip && hotel.skip.length > 0 && (
      <section class="skip" aria-label={`Rooms to skip at ${hotel.name}`}>
        <h4>Not these</h4>
        <ul>
          {hotel.skip.map((r) => (
            <li>
              <p class="room">{r.room}</p>
              {r.note && <p class="note">{r.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  {hotel.notes && hotel.notes.length > 0 && (
    <div class="notes">
      {hotel.notes.map((n) => <p>{n}</p>)}
    </div>
  )}

  <div class="foot">
    <a class="btn" href={goHref(hotel.id)} rel="sponsored nofollow noopener" target="_blank">{pricesButton}</a>
    <p class="small sources">
      Sources:{' '}
      {sources.map((s, i) => (
        <>
          {s.url ? <a class="text-link" href={s.url} rel="noopener">{s.label}</a> : s.label}
          {i < lastIndex - 1 ? ', ' : i === lastIndex - 1 ? ' and ' : ''}
        </>
      ))}. Checked {monthLabel(checked)}.
    </p>
  </div>
</article>

<style>
  .top.has-photo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 28px;
    align-items: start;
    margin-bottom: 8px;
  }
  .shot {
    margin: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--sky);
  }
  .shot figcaption {
    margin-top: 6px;
    color: var(--zinc);
  }
  @media (max-width: 760px) {
    .top.has-photo {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
  .hotel {
    padding: 36px 0 40px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 16px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .head h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
  }
  .where {
    margin-top: 8px;
    color: var(--ink-soft);
  }
  .facts {
    color: var(--zinc);
  }
  .lists {
    margin-top: 24px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px 48px;
    align-items: start;
  }
  h4 {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--zinc);
    margin-bottom: 10px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .book li {
    padding-left: 14px;
    border-left: 3px solid var(--brass);
  }
  .skip li {
    padding-left: 14px;
    border-left: 3px solid var(--line);
  }
  .skip .room {
    color: var(--ink-soft);
    font-weight: 460;
  }
  .note {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--zinc);
    max-width: 62ch;
  }
  .notes {
    margin-top: 22px;
    max-width: 66ch;
    color: var(--ink-soft);
  }
  .notes p + p {
    margin-top: 8px;
  }
  .foot {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  .sources {
    flex: 1 1 280px;
    max-width: 60ch;
  }
  @media (max-width: 760px) {
    .lists {
      grid-template-columns: minmax(0, 1fr);
    }
    .foot .btn {
      width: 100%;
    }
  }
</style>
