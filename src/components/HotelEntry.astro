---
import LevelPill from './LevelPill.astro';
import { goHref, monthLabel, pricesButton, starsLabel, type Hotel } from '../lib/views';
import { site } from '../data/site';

interface Props {
  hotel: Hotel;
  checked: string;
  n: number;
  city: string;
  country: string;
  campaign: string;
}

const { hotel, checked, n, city, country, campaign } = Astro.props;

// Stay22 list centred on the hotel's own address at the closest zoom: the first card is this hotel, with its photos and prices
// (owner checked Arc de Triomphe and Eiffel Tower on /lab/hotel-photos/, 19 Oct 2026). City and country are added when the address lacks them.
const has = (t: string) => hotel.where.toLowerCase().includes(t.toLowerCase());
const address = [hotel.where, has(city) ? '' : city, has(country) ? '' : country].filter(Boolean).join(', ');
const photosSrc = site.stay22Aid
  ? `https://www.stay22.com/embed/gm?${new URLSearchParams({
      aid: site.stay22Aid,
      address,
      zoom: '18',
      viewmode: 'listview',
      limit: '5',
      campaign,
      maincolor: '1c2633',
    }).toString()}`
  : '';
const facts = [hotel.distance, starsLabel(hotel.stars)].filter(Boolean).join(', ');

// "a, b and c" with official sources linked.
const sources = hotel.sources;
const lastIndex = sources.length - 1;
---
<article class="hotel" id={hotel.id} aria-labelledby={`${hotel.id}-name`}>
  {photosSrc && (
    <div class="photos">
      <iframe src={photosSrc} title={`Photos and prices for ${hotel.name}, from Stay22`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <p class="small">Photos and prices: Stay22</p>
    </div>
  )}

  <div class="info">
    <header class="head">
      <div class="who">
        <h3 id={`${hotel.id}-name`}>{hotel.name}</h3>
        <p class="where">
          {hotel.where}{facts && <> · <span class="facts">{facts.charAt(0).toUpperCase() + facts.slice(1)}</span></>}
        </p>
      </div>
      <LevelPill level={hotel.level} />
    </header>

    <section class="book" aria-label={`Rooms to book at ${hotel.name}`}>
      <h4>Book one of these</h4>
      <ul>
        {hotel.book.map((r) => (
          <li>
            <p class="room">{r.room}</p>
            {r.note && <p class="note">{r.note}</p>}
          </li>
        ))}
      </ul>
    </section>

    <div class="cta">
      <a class="btn" href={goHref(hotel.id)} rel="sponsored nofollow noopener" target="_blank">{pricesButton}</a>
    </div>

    {hotel.skip && hotel.skip.length > 0 && (
      <details class="skip">
        <summary>Not these ({hotel.skip.length}): look-alike rooms</summary>
        <ul>
          {hotel.skip.map((r) => (
            <li>
              <p class="room">{r.room}</p>
              {r.note && <p class="note">{r.note}</p>}
            </li>
          ))}
        </ul>
      </details>
    )}

    {hotel.notes && hotel.notes.length > 0 && (
      <div class="notes">
        {hotel.notes.map((n) => <p>{n}</p>)}
      </div>
    )}

    <p class="small sources">
      Sources:{' '}
      {sources.map((s, i) => (
        <>
          {s.url ? <a class="text-link" href={s.url} rel="noopener">{s.label}</a> : s.label}
          {i < lastIndex - 1 ? ', ' : i === lastIndex - 1 ? ' and ' : ''}
        </>
      ))}. Checked {monthLabel(checked)}.
    </p>
  </div>
</article>

<style>
  /* One white result card per hotel, like a booking list: photos left, the answer and the button right. */
  .hotel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 28px;
    padding: 20px;
    margin-top: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    scroll-margin-top: 16px;
  }
  .photos iframe {
    display: block;
    width: 100%;
    height: 520px;
    border: 0;
    border-radius: var(--radius);
    background: var(--sky);
  }
  .photos .small {
    margin-top: 6px;
  }
  .head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .who {
    flex: 1 1 220px;
    min-width: 0;
  }
  .who h3 {
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 1.875rem);
  }
  .where {
    margin-top: 4px;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .facts {
    color: var(--zinc);
  }
  .book {
    margin-top: 20px;
    padding: 16px 18px;
    background: var(--paper);
    border-radius: var(--radius);
  }
  h4 {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--zinc);
    margin-bottom: 10px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .book li {
    padding-left: 12px;
    border-left: 3px solid var(--brass);
  }
  .book .room {
    font-size: 1.375rem;
    line-height: 1.2;
  }
  .cta {
    margin-top: 16px;
    display: flex;
    justify-content: flex-end;
  }
  .skip {
    margin-top: 8px;
  }
  .skip summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--zinc);
  }
  .skip ul {
    margin-top: 6px;
  }
  .skip li {
    padding-left: 12px;
    border-left: 3px solid var(--line);
  }
  .skip .room {
    color: var(--ink-soft);
    font-weight: 460;
  }
  .note {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--zinc);
    max-width: 62ch;
  }
  .notes {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .notes p + p {
    margin-top: 8px;
  }
  .sources {
    margin-top: 10px;
  }
  @media (max-width: 900px) {
    .hotel {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 16px;
    }
    .photos iframe {
      height: 480px;
    }
    .cta .btn {
      width: 100%;
    }
  }
</style>
