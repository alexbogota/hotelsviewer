---
// Stay22 hotel map around a landmark (https://dev.stay22.com/docs/maps).
// Shown only when site.stay22Aid is set. These hotels are NOT checked by us, and the text says so.
import { site } from '../data/site';

interface Props {
  lat: number;
  lng: number;
  near: string; // "the Eiffel Tower"
  campaign: string; // where the booking came from, e.g. "city-paris"
}
const { lat, lng, near, campaign } = Astro.props;

const params = new URLSearchParams({
  aid: site.stay22Aid,
  lat: String(lat),
  lng: String(lng),
  zoom: '15',
  campaign,
  maincolor: '1c2633',
});
const src = `https://www.stay22.com/embed/gm?${params.toString()}`;
---
{site.stay22Aid && (
  <section class="map" aria-labelledby="map-heading">
    <h2 id="map-heading">More hotels near {near}</h2>
    <p class="measure">This map comes from our partner Stay22 and shows hotels around {near} with current prices. We haven't checked these hotels for a view. Look for a room category that names the view, or start with the hotels on our view pages. Bookings made through the map may earn us a commission.</p>
    <iframe
      src={src}
      title={`Map of hotels near ${near}, from Stay22`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </section>
)}

<style>
  .map {
    margin-top: 72px;
  }
  .map p {
    margin-top: 12px;
    color: var(--ink-soft);
  }
  iframe {
    display: block;
    width: 100%;
    height: 480px;
    margin-top: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky);
  }
  @media (max-width: 640px) {
    iframe {
      height: 420px;
    }
  }
</style>
