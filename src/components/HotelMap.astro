---
// Stay22 hotel map around a landmark (https://dev.stay22.com/docs/maps).
// Shown only when site.stay22Aid is set. These hotels are NOT checked by us, and the text says so.
import { site } from '../data/site';

interface Props {
  lat: number;
  lng: number;
  near: string; // "the Eiffel Tower"
  campaign: string; // where the booking came from, e.g. "city-paris"
  mode?: 'map' | 'listview'; // listview = hotels as photo cards (owner liked them in search, 19 Oct 2026)
}
const { lat, lng, near, campaign, mode = 'map' } = Astro.props;
const photos = mode === 'listview';

const params = new URLSearchParams({
  aid: site.stay22Aid,
  lat: String(lat),
  lng: String(lng),
  zoom: '15',
  campaign,
  maincolor: '1c2633',
  viewmode: mode,
  ...(photos ? { limit: '12' } : {}),
});
const src = `https://www.stay22.com/embed/gm?${params.toString()}`;
---
{site.stay22Aid && (
  <section class={photos ? 'map photos' : 'map'} aria-labelledby={`${mode}-heading`}>
    <h2 id={`${mode}-heading`}>{photos ? `Hotels near ${near}, with photos` : `More hotels near ${near}`}</h2>
    <p class="measure">{photos ? 'These hotels come' : 'This map comes'} from our partner Stay22 and shows hotels around {near} with current prices. We haven't checked these hotels for a view.</p>
    <iframe
      src={src}
      title={`${photos ? 'Photos of hotels' : 'Map of hotels'} near ${near}, from Stay22`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </section>
)}

<style>
  .map {
    margin-top: 72px;
  }
  .map.photos {
    margin-top: 56px;
  }
  .photos iframe {
    height: 640px;
  }
  .map p {
    margin-top: 12px;
    color: var(--ink-soft);
  }
  iframe {
    display: block;
    width: 100%;
    height: 480px;
    margin-top: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky);
  }
  @media (max-width: 640px) {
    iframe {
      height: 420px;
    }
    .photos iframe {
      height: 600px;
    }
  }
</style>
