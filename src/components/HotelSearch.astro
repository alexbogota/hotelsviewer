---
// Search box for any place in the world, with suggestions while typing.
// Suggestions come from Photon (https://github.com/komoot/photon, OpenStreetMap data): "Valencia, Carabobo, Venezuela"
// and "Valencia, Spain" are separate choices. A chosen place sends its coordinates to /hotels/?q=..&lat=..&lng=..,
// so the Stay22 map opens on the right one. Without a choice the typed text is sent as before.
// Several boxes on one page are fine: each form works on its own.
interface Props {
  value?: string;
  id?: string;
}
const { value = '', id = 'hotel-search' } = Astro.props;
---
<form class="search" action="/hotels/" method="get" role="search" data-hotel-search>
  <label for={id}>Where are you going?</label>
  <div class="row">
    <div class="field">
      <input
        id={id}
        name="q"
        type="search"
        required
        minlength="2"
        maxlength="80"
        placeholder="A city, a landmark or an address"
        value={value}
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls={`${id}-list`}
      />
      <input type="hidden" name="lat" disabled />
      <input type="hidden" name="lng" disabled />
      <input type="hidden" name="kind" disabled />
      <ul id={`${id}-list`} class="suggest" role="listbox" hidden></ul>
    </div>
    <button class="btn" type="submit">Find hotels</button>
  </div>
  <p class="small credit" hidden>Place suggestions: <a class="text-link" href="https://github.com/komoot/photon" rel="noopener">Photon</a>, map data © <a class="text-link" href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors.</p>
</form>

<script>
  type Place = { label: string; lat: number; lng: number; kind: string };

  // Places people stay in, not streets or shops: cities, towns, villages, regions, landmarks.
  const LAYERS = ['city', 'locality', 'district', 'county', 'state', 'country', 'other'];

  function labelOf(p: Record<string, string>): string {
    const parts = [p.name, p.city, p.state, p.country].filter(Boolean);
    return parts.filter((x, i) => parts.indexOf(x) === i).join(', ');
  }

  async function suggest(q: string, signal: AbortSignal): Promise<Place[]> {
    const u = new URL('https://photon.komoot.io/api/');
    u.searchParams.set('q', q);
    u.searchParams.set('limit', '6');
    u.searchParams.set('lang', 'en');
    for (const l of LAYERS) u.searchParams.append('layer', l);
    const r = await fetch(u, { signal });
    if (!r.ok) return [];
    const data = await r.json();
    const out: Place[] = [];
    for (const f of data.features || []) {
      const [lng, lat] = f.geometry?.coordinates || [];
      const label = labelOf(f.properties || {});
      if (typeof lat !== 'number' || !label || out.some((o) => o.label === label)) continue;
      out.push({ label, lat, lng, kind: f.properties.type || '' });
    }
    return out;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-hotel-search]')) {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
    const lat = form.querySelector<HTMLInputElement>('input[name="lat"]')!;
    const lng = form.querySelector<HTMLInputElement>('input[name="lng"]')!;
    const kind = form.querySelector<HTMLInputElement>('input[name="kind"]')!;
    const list = form.querySelector<HTMLUListElement>('.suggest')!;
    const credit = form.querySelector<HTMLElement>('.credit')!;
    let items: Place[] = [];
    let active = -1;
    let timer = 0;
    let ctrl: AbortController | null = null;

    const setPoint = (p: Place | null) => {
      for (const el of [lat, lng, kind]) el.disabled = !p;
      if (p) {
        lat.value = p.lat.toFixed(5);
        lng.value = p.lng.toFixed(5);
        kind.value = p.kind;
      }
    };
    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };
    // The visitor's own last searches, only in their browser (shown by ViewPanel on the home page).
    const remember = () => {
      try {
        const q = input.value.trim();
        if (q.length < 2) return;
        const params = new URLSearchParams({ q });
        for (const el of [lat, lng, kind]) if (!el.disabled && el.value) params.set(el.name, el.value);
        const href = `/hotels/?${params.toString()}`;
        const old: { label: string; href: string }[] = JSON.parse(localStorage.getItem('hv-recent') || '[]');
        const list = [{ label: q, href }, ...(Array.isArray(old) ? old : []).filter((r) => r && r.label !== q)].slice(0, 5);
        localStorage.setItem('hv-recent', JSON.stringify(list));
      } catch {
        /* storage blocked: nothing to remember */
      }
    };
    form.addEventListener('submit', remember);
    const choose = (i: number) => {
      const p = items[i];
      if (!p) return;
      input.value = p.label;
      document.dispatchEvent(new CustomEvent('hotelsearch:input', { detail: p.label }));
      setPoint(p);
      close();
      remember();
      form.submit();
    };
    const mark = (i: number) => {
      active = i;
      [...list.children].forEach((li, k) => li.setAttribute('aria-selected', String(k === i)));
      if (i >= 0) input.setAttribute('aria-activedescendant', `${list.id}-${i}`);
    };
    const show = () => {
      list.replaceChildren(
        ...items.map((p, i) => {
          const li = document.createElement('li');
          li.id = `${list.id}-${i}`;
          li.role = 'option';
          li.textContent = p.label;
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            choose(i);
          });
          return li;
        }),
      );
      list.hidden = items.length === 0;
      input.setAttribute('aria-expanded', String(items.length > 0));
      mark(-1);
    };

    input.addEventListener('input', () => {
      document.dispatchEvent(new CustomEvent('hotelsearch:input', { detail: input.value }));
      setPoint(null);
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) {
        items = [];
        show();
        return;
      }
      timer = window.setTimeout(async () => {
        ctrl?.abort();
        ctrl = new AbortController();
        try {
          items = await suggest(q, ctrl.signal);
          credit.hidden = false;
          show();
        } catch {
          /* no suggestions: the form still works with the typed text */
        }
      }, 250);
    });
    input.addEventListener('keydown', (e) => {
      if (list.hidden) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        mark(Math.min(active + 1, items.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        mark(Math.max(active - 1, 0));
      } else if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        choose(active);
      } else if (e.key === 'Escape') {
        close();
      }
    });
    input.addEventListener('blur', () => window.setTimeout(close, 150));
  }
</script>

<style>
  .search label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .field {
    position: relative;
    flex: 1 1 240px;
    min-width: 0;
  }
  input[type='search'] {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    font: inherit;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  button {
    min-height: 48px;
  }
  .suggest {
    position: absolute;
    z-index: 20;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    margin: 0;
    padding: 4px 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(28 38 51 / 0.12);
  }
  /* the rows are made by the script, so the scoped style must reach them */
  .suggest :global(li) {
    padding: 12px 14px;
    min-height: 44px;
    cursor: pointer;
  }
  .suggest :global(li:hover),
  .suggest :global(li[aria-selected='true']) {
    background: var(--sky);
  }
  .credit {
    margin-top: 8px;
    color: var(--ink-soft);
  }
</style>
