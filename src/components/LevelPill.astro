---
import { levels, type Level } from '../lib/views';

interface Props {
  level: Level;
}

const { level } = Astro.props;
const info = levels[level];
---
<a class:list={['pill', level]} href="/about/#how-we-check" title={info.text}>
  {info.label}<span class="visually-hidden">: {info.text}</span>
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 3px 12px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    background: var(--panel);
  }
  /* Strongest evidence = solid; listed = outline; reported = dashed. */
  .pictured {
    background: var(--ink);
    color: #fff;
  }
  .reported {
    border-style: dashed;
    border-color: var(--zinc);
    color: var(--zinc);
    background: transparent;
  }
  .pill:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
