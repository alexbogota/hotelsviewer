---
// The mark: an arched hotel window with the horizon and a brass sun. The wordmark is set in Newsreader.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M7 28.5V13.5a9 9 0 0 1 18 0v15Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
    <path d="M7.5 21.5h17" stroke="currentColor" stroke-width="2" />
    <circle cx="19.8" cy="15.8" r="2.7" fill="#a8752a" />
  </svg>
  <span class="word">HotelsViewer</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .word {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 620;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }
</style>
