---
// "After the window": tickets and transport we checked for a view, shown after the hotels.
// Only rows that already have a partner link reach this component (liveExtras in src/lib/views.ts).
import { goHref, monthLabel, type Extra } from '../lib/views';

interface Props {
  items: Extra[];
}

const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="extras" aria-labelledby="extras-heading">
    <h2 id="extras-heading">After the window</h2>
    <p class="measure lead">Once the room is booked: tickets and transport we checked on the seller's own page. These are partner links. If you book through them we may earn a commission, at no extra cost to you. <a class="text-link" href="/disclosure/">How we earn</a></p>
    <ul>
      {items.map((e) => (
        <li class="item">
          <div class="body">
            <p class="kind">{e.kind}</p>
            <h3>{e.title}</h3>
            {e.note && <p class="note">{e.note}</p>}
            <p class="small">Sold by {e.partner}. Checked {monthLabel(e.checked)}.</p>
          </div>
          <a class="btn btn-quiet" href={goHref(e.id)} rel="sponsored nofollow noopener" target="_blank">Open {e.partner}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .extras {
    margin-top: 72px;
  }
  .lead {
    margin-top: 12px;
    color: var(--ink-soft);
  }
  ul {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 32px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .kind {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--zinc);
  }
  h3 {
    margin-top: 4px;
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
  }
  .note {
    margin-top: 8px;
    max-width: 62ch;
    color: var(--ink-soft);
  }
  .body .small {
    margin-top: 8px;
  }
  @media (max-width: 760px) {
    .item {
      grid-template-columns: minmax(0, 1fr);
    }
    .item .btn {
      width: 100%;
    }
  }
</style>
