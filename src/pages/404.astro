---
import Layout from '../layouts/Layout.astro';
import { views } from '../lib/views';
---
<Layout title="Page not found | HotelsViewer" description="This page doesn't exist on HotelsViewer." noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>This page isn't here</h1>
      <p class="dek measure">The address may have a typo, or the page has moved. These are the views we cover:</p>
    </header>
    <ul class="list">
      {views.map((v) => <li><a class="text-link" href={`/views/${v.slug}/`}>{v.landmark}</a>, {v.city}</li>)}
    </ul>
    <p class="back"><a class="btn" href="/">Go to the home page</a></p>
  </div>
</Layout>

<style>
  .list {
    margin: 20px 0 0;
    padding-left: 1.2em;
  }
  .list li + li {
    margin-top: 6px;
  }
  .back {
    margin-top: 32px;
  }
</style>
