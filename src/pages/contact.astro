---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout
  title="Contact HotelsViewer"
  description="Stayed in one of the rooms we list, or found a room name that changed? Tell HotelsViewer and we'll check it."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="dek measure">Stayed in one of these rooms? Found a room name that changed, or a view that's gone? Tell us and we'll check it.</p>
    </header>

    <div class="cols">
      <div class="block">
        <h2>Email</h2>
        <p><a class="mail" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="small">We usually reply within 2 business days.</p>
      </div>
      <div class="block">
        <h2>Hotels</h2>
        <p>If your hotel has rooms that face a landmark, send us the exact room category names and any photos of the view you hold the rights to. Listings are free.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .cols {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 880px;
  }
  .block {
    padding: 26px;
    background: var(--panel);
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
  }
  .block h2 {
    font-size: 1.375rem;
    margin-bottom: 10px;
  }
  .block p + p {
    margin-top: 8px;
  }
  .mail {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 560;
    color: var(--ink);
    text-decoration-color: var(--brass);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
