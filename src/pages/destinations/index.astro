---
// All countries and cities with at least one checked view. Built from the view data files.
import Layout from '../../layouts/Layout.astro';
import { cities, cityHref, countries, countryHref } from '../../lib/places';
import { views } from '../../lib/views';

const n = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
---
<Layout
  title="Destinations: hotels with a view, by country and city | HotelsViewer"
  description={`Hotels with rooms that face a landmark, sorted by country and city. ${n(countries.length, 'country', 'countries')}, ${n(cities.length, 'city', 'cities')} and ${n(views.length, 'view', 'views')} checked so far.`}
>
  <div class="wrap">
    <header class="page-head">
      <h1>Destinations</h1>
      <p class="dek measure">Every country and city where we have checked hotel rooms with a view: {n(countries.length, 'country', 'countries')}, {n(cities.length, 'city', 'cities')} and {n(views.length, 'view', 'views')} so far. A city is added once we have checked at least one view in it.</p>
    </header>

    <div class="atlas">
      {countries.map((c) => (
        <section class="country" aria-labelledby={`c-${c.slug}`}>
          <h2 id={`c-${c.slug}`}><a href={countryHref(c)}>{c.name}</a></h2>
          <ul class="cities">
            {c.cities.map((city) => (
              <li>
                <a class="city" href={cityHref(city)}>{city.name}</a>
                {city.region && <span class="region small">{city.region}</span>}
                <p class="views small">
                  {city.views.map((v, i) => (
                    <>{i > 0 && ', '}<a href={`/views/${v.slug}/`}>{v.landmark}</a></>
                  ))}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .atlas {
    margin-top: 40px;
    border-top: 3px solid var(--ink);
  }
  .country {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 12px 40px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .country h2 {
    font-size: 1.75rem;
  }
  .country h2 a {
    color: inherit;
    text-decoration: none;
  }
  .country h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .city {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--ink);
    text-decoration-color: var(--brass);
    text-underline-offset: 4px;
  }
  .region {
    margin-left: 10px;
  }
  .views {
    margin-top: 4px;
  }
  .views a {
    color: var(--brass-ink);
  }
  @media (max-width: 720px) {
    .country {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
