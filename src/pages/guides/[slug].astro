---
import Layout from '../../layouts/Layout.astro';
import ArchPhoto from '../../components/ArchPhoto.astro';
import { guides, getGuide, dateLabel, type Guide } from '../../lib/guides';
import TripExtras from '../../components/TripExtras.astro';
import { getView, goHref, liveExtras, photoFor, pricesButton } from '../../lib/views';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const guide = getGuide(Astro.params.slug as string) as Guide;
const view = getView(guide.view);
const photo = photoFor(guide.view);
const picks = (guide.hotels ?? []).map((id) => view?.hotels.find((h) => h.id === id)).filter((h) => !!h);
---
<Layout title={`${guide.title} | HotelsViewer`} description={guide.description} ogImage={photo?.src} ogImageAlt={photo?.alt}>
  <div class="wrap">
    <nav class="crumbs small" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides/">Guides</a>
    </nav>

    <article>
      <header class="head">
        <div class="text">
          <h1>{guide.title}</h1>
          <p class="dek">{guide.dek}</p>
          <p class="small by">{dateLabel(guide.date)} · Room names checked {guide.checked}</p>
        </div>
        <div class="pic">
          <ArchPhoto photo={photo} landmark={view?.landmark ?? ''} credit eager />
        </div>
      </header>

      <div class="body">
        {guide.sections.map((s) => (
          <section>
            <h2>{s.h}</h2>
            {s.p.map((t) => <p>{t}</p>)}
          </section>
        ))}
        {picks.length > 0 && (
          <section class="book" aria-labelledby="book-heading">
            <h2 id="book-heading">Book the room</h2>
            <p class="small">Some links may earn us a commission; it never changes which rooms we list.</p>
            <ul>
              {picks.map((h) => (
                <li>
                  <div>
                    <p class="room">{h!.name}</p>
                    <p class="small">{h!.book[0].room}</p>
                  </div>
                  <a class="btn" href={goHref(h!.id)} rel="sponsored nofollow noopener" target="_blank">{pricesButton}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="go"><a class="btn btn-quiet" href={guide.cta.href}>{guide.cta.label}</a></p>

        {view && <TripExtras items={liveExtras(view)} />}

        <section class="sources">
          <h2>Sources</h2>
          <ul>
            {guide.sources.map((s) => (
              <li>{s.url ? <a class="text-link" href={s.url} rel="noopener">{s.label}</a> : s.label}</li>
            ))}
          </ul>
        </section>
      </div>
    </article>
  </div>
</Layout>

<style>
  .crumbs {
    display: flex;
    gap: 6px 10px;
    padding-top: 22px;
  }
  .crumbs a {
    color: var(--zinc);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 48px;
    align-items: center;
    padding-top: 28px;
  }
  h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.25rem);
    max-width: 20ch;
  }
  .dek {
    margin-top: 16px;
    max-width: 52ch;
  }
  .by {
    margin-top: 14px;
  }
  .body {
    margin-top: 56px;
    max-width: 68ch;
  }
  .body section {
    margin-top: 40px;
  }
  .body h2 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }
  .body p {
    margin-top: 14px;
    color: var(--ink-soft);
  }
  .book ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .book li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .book .room {
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0;
  }
  .book .small {
    margin-top: 2px;
  }
  .go {
    margin-top: 40px;
  }
  .sources ul {
    margin: 14px 0 0;
    padding-left: 1.2em;
    font-size: 0.9375rem;
  }
  .sources li + li {
    margin-top: 6px;
  }
  @media (max-width: 860px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .pic {
      max-width: 340px;
    }
    .go .btn {
      width: 100%;
    }
  }
</style>
