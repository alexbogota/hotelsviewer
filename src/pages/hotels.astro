---
// Hotels anywhere: /hotels/?q=<place>. One static page for every place in the world.
// The Stay22 map takes any place name (parameter "address", https://dev.stay22.com/docs/maps/parameters).
// If the place matches one of our checked views (city, country or landmark), those views are shown first.
import Layout from '../layouts/Layout.astro';
import HotelSearch from '../components/HotelSearch.astro';
import ArchPhoto from '../components/ArchPhoto.astro';
import ViewWindows from '../components/ViewWindows.astro';
import { photoFor, views } from '../lib/views';
import { placeLabel } from '../lib/places';
import { site } from '../data/site';

const known = views.map((v) => ({
  slug: v.slug,
  landmark: v.landmark,
  city: v.city,
  country: v.country,
  teaser: v.teaser,
  lat: v.coords?.lat,
  lng: v.coords?.lng,
}));
---
<Layout
  title="Find hotels anywhere, and the room with the view where we know it"
  description="Type any city, landmark or address to see hotels there with current prices. Where we have checked the rooms, we show which one to book for the view."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Find hotels anywhere</h1>
      <p class="dek measure">Type a city, a landmark or an address. You get the hotels there with current prices, and where we have checked the rooms, the one to book for the view.</p>
    </header>

    <div class="box"><HotelSearch id="hotels-q" /></div>

    <section id="ours" class="ours" hidden aria-labelledby="ours-heading">
      <h2 id="ours-heading">There's a view here</h2>
      <ul class="cards">
        {views.map((v) => (
          <li data-view={v.slug} hidden>
            <a href={`/views/${v.slug}/`}>
              <ArchPhoto photo={photoFor(v.slug)} landmark={v.landmark} variant="thumb" />
            </a>
            <div class="card-text">
              <h3 class="room"><a href={`/views/${v.slug}/`}>{v.landmark}</a></h3>
              <p class="small place">{placeLabel(v)}</p>
              <p>{v.teaser}</p>
              <p class="small">We checked {v.hotels.length} hotels here and know which room categories come with the view. <a class="text-link" href={`/views/${v.slug}/`}>See which room to book</a></p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {site.stay22Aid && (
      <section id="results" class="results" hidden aria-labelledby="results-heading">
        <h2 id="results-heading">Hotels in <span id="place"></span></h2>
        <p class="measure note">Hotels with photos and current prices from our partner Stay22, from several booking sites. We haven't checked these hotels for a view. Bookings made here may earn us a commission.</p>
        <div class="modes" role="group" aria-label="Show hotels as">
          <button type="button" class="btn" data-mode="listview" aria-pressed="true">Photos</button>
          <button type="button" class="btn btn-quiet" data-mode="map" aria-pressed="false">Map</button>
        </div>
        <iframe id="map" title="Hotels, from Stay22" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </section>
    )}

    <section id="start" class="start" aria-labelledby="start-heading">
      <h2 id="start-heading">Or start with a view</h2>
      <p class="measure note">For these places we know which hotel room comes with the view.</p>
      <ViewWindows />
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ known, aid: site.stay22Aid }}>
  (function () {
    var q = (new URLSearchParams(location.search).get('q') || '').trim().slice(0, 80);
    if (q.length < 2) return;
    var input = document.getElementById('hotels-q');
    if (input) input.value = q;
    var low = q.toLowerCase();
    var norm = function (s) { return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };
    var nq = norm(low);
    var sp = new URLSearchParams(location.search);
    var plat = parseFloat(sp.get('lat') || ''), plng = parseFloat(sp.get('lng') || '');
    var hasPoint = isFinite(plat) && isFinite(plng) && Math.abs(plat) <= 90 && Math.abs(plng) <= 180;
    var kind = sp.get('kind') || '';
    var km = function (a, b, c, d) {
      var r = Math.PI / 180, x = Math.sin((c - a) * r / 2), y = Math.sin((d - b) * r / 2);
      return 12742 * Math.asin(Math.sqrt(x * x + Math.cos(a * r) * Math.cos(c * r) * y * y));
    };
    // A chosen place: our views within 40 km of it (a whole country: views in that country).
    // Only typed text: views whose city, country or landmark is in the text.
    var hits = hasPoint && kind !== 'country' ? known.filter(function (v) {
      return typeof v.lat === 'number' && km(plat, plng, v.lat, v.lng) <= 40;
    }) : known.filter(function (v) {
      return [v.city, v.country, v.landmark].some(function (f) {
        var nf = norm(f);
        return nf && (nq.indexOf(nf) !== -1 || (nq.length >= 3 && nf.indexOf(nq) !== -1));
      });
    });
    if (hits.length) {
      hits.forEach(function (v) {
        var li = document.querySelector('[data-view="' + v.slug + '"]');
        if (li) li.hidden = false;
      });
      document.getElementById('ours').hidden = false;
    }
    var start = document.getElementById('start');
    if (start) start.hidden = true;
    var map = document.getElementById('map');
    if (map && aid) {
      var params = new URLSearchParams({ aid: aid, campaign: 'search', maincolor: '1c2633' });
      if (hasPoint) {
        params.set('lat', plat.toFixed(5));
        params.set('lng', plng.toFixed(5));
        params.set('zoom', kind === 'country' ? '6' : kind === 'state' ? '8' : '11'); // 12 was too close: no hotels in Valencia, Venezuela (owner, 19 Oct 2026); 10-11 shows them
      } else {
        params.set('address', q);
      }
      // First the hotels as photo cards (Stay22 list view, tried by the owner on 19 Oct 2026), the map one tap away.
      params.set('limit', '30');
      var show = function (mode) {
        params.set('viewmode', mode);
        map.src = 'https://www.stay22.com/embed/gm?' + params.toString();
        map.title = (mode === 'map' ? 'Map of hotels in ' : 'Hotels in ') + q + ', from Stay22';
        document.querySelectorAll('.modes button').forEach(function (b) {
          var on = b.getAttribute('data-mode') === mode;
          b.setAttribute('aria-pressed', String(on));
          b.className = on ? 'btn' : 'btn btn-quiet';
        });
      };
      document.querySelectorAll('.modes button').forEach(function (b) {
        b.addEventListener('click', function () { show(b.getAttribute('data-mode')); });
      });
      show('listview');
      document.getElementById('place').textContent = q;
      document.getElementById('results').hidden = false;
      document.title = 'Hotels in ' + q + ' | HotelsViewer';
    }
  })();
</script>

<style>
  .box {
    margin-top: 28px;
  }
  .ours,
  .results {
    margin-top: 48px;
  }
  .start {
    margin-top: 64px;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    gap: 32px;
  }
  .cards li {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }
  .cards li[hidden] {
    display: none;
  }
  .card-text h3 {
    font-size: 1.625rem;
  }
  .card-text h3 a {
    color: inherit;
  }
  .card-text p {
    margin-top: 8px;
  }
  .place,
  .note {
    margin-top: 8px;
    color: var(--ink-soft);
  }
  .modes {
    margin-top: 20px;
    display: flex;
    gap: 8px;
  }
  iframe {
    display: block;
    width: 100%;
    height: 760px;
    margin-top: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky);
  }
  @media (max-width: 640px) {
    iframe {
      height: 620px;
    }
    .cards li {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .cards li > a {
      max-width: 240px;
    }
  }
</style>
