---
import Layout from '../layouts/Layout.astro';
import ViewWindows from '../components/ViewWindows.astro';
import Decoder from '../components/Decoder.astro';
import LevelPill from '../components/LevelPill.astro';
import HotelSearch from '../components/HotelSearch.astro';
import ViewPanel from '../components/ViewPanel.astro';
import { levels, type Level } from '../lib/views';

const order: Level[] = ['pictured', 'listed', 'reported'];

const pairs = [
  {
    left: 'Paris View',
    right: 'Eiffel View',
    text: 'At the Shangri-La Paris, the “Paris View” suites are sold with a city view. Only the categories with “Eiffel” in the name come with the tower.',
    where: '/views/eiffel-tower/#shangri-la-paris',
  },
  {
    left: 'Terrace',
    right: 'Fountain View',
    text: 'At The Cosmopolitan in Las Vegas, terrace rooms are sold with and without the Bellagio fountains. The view is only promised when the name ends in “Fountain View”.',
    where: '/views/bellagio-fountains/#the-cosmopolitan',
  },
  {
    left: 'US Fallsview',
    right: 'Canadian Fallsview',
    text: 'At the Hilton in Niagara Falls, “US” rooms face the American Falls and “Canadian” rooms face the Horseshoe Falls. Rooms marked “Canadian/US” see both.',
    where: '/views/niagara-falls/#hilton-niagara-falls-fallsview',
  },
];
---
<Layout
  title="HotelsViewer: find a hotel anywhere, and the room with the view"
  description="Search hotels in any city with current prices. Where there's a famous view, like the Eiffel Tower or Mount Fuji, we show which room category to book for it."
>
  <section class="hero wrap">
    <div class="copy">
      <h1>Find a hotel anywhere. Book the room with the view.</h1>
      <p class="dek">Search any city, landmark or address for hotels with current prices. Where there's a famous view, we read the room names and tell you which one to book.</p>
      <div class="find"><HotelSearch /></div>
      <p class="small try">Try <a class="text-link" href="/hotels/?q=Paris%2C+France&amp;lat=48.85661&amp;lng=2.35222&amp;kind=city">Paris</a>, <a class="text-link" href="/hotels/?q=Kyoto%2C+Japan&amp;lat=35.01164&amp;lng=135.76802&amp;kind=city">Kyoto</a> or <a class="text-link" href="/hotels/?q=Cartagena%2C+Colombia&amp;lat=10.39105&amp;lng=-75.47942&amp;kind=city">Cartagena</a></p>
    </div>

    <ViewPanel />
  </section>

<section id="views" class="views wrap" aria-labelledby="views-heading">
    <h2 id="views-heading">Rooms with a view</h2>
    <p class="dek measure">For these places we have read the room categories, hotel by hotel, and know which one comes with the view.</p>
    <ViewWindows />
  </section>

  <section class="check wrap" aria-labelledby="check-heading">
    <h2 id="check-heading">How sure we are</h2>
    <p class="dek measure">Every hotel carries one of three labels, so you know what stands behind a view before you pay for it.</p>
    <dl class="levels">
      {order.map((l) => (
        <div class="level">
          <dt><LevelPill level={l} /></dt>
          <dd>{levels[l].text}</dd>
        </div>
      ))}
    </dl>
    <p class="small more">Each hotel also shows the month we checked it and where the room names came from. <a class="text-link" href="/about/#how-we-check">More about how we check</a></p>
  </section>

  <div class="wrap">
    <Decoder heading="Room names that don't mean what they seem" pairs={pairs} />
  </div>
</Layout>

<style>
  .find {
    margin-top: 28px;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
    padding-top: 72px;
    padding-bottom: 24px;
  }
  .copy h1 {
    max-width: 16ch;
  }
  .copy .dek {
    margin-top: 20px;
    max-width: 52ch;
  }
  .try {
    margin-top: 12px;
    color: var(--zinc);
  }
  .views .dek {
    margin-top: 12px;
  }
  .views {
    margin-top: 72px;
  }
  .check {
    margin-top: 88px;
  }
  .check .dek {
    margin-top: 12px;
  }
  .levels {
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 40px;
  }
  .level dt {
    margin-bottom: 10px;
  }
  .level dd {
    margin: 0;
    color: var(--ink-soft);
    max-width: 36ch;
  }
  .more {
    margin-top: 24px;
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 40px;
      gap: 32px;
    }
    .levels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
