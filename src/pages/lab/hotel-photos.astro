---
// Test page (not linked, noindex): which Stay22 settings show the hotel we checked, and not apartments nearby?
// A = settings used on the site now (worked for Arc de Triomphe and Eiffel Tower). B = hotels from Booking only, no search bar or filters.
import Layout from '../../layouts/Layout.astro';
import { getView, type View } from '../../lib/views';
import { site } from '../../data/site';

const view = getView('acropolis') as View;
const rows = view.hotels.slice(0, 4).map((h) => ({ name: h.name, address: `${h.where}, ${view.city}, ${view.country}` }));
const make = (address: string, extra: Record<string, string>) =>
  `https://www.stay22.com/embed/gm?${new URLSearchParams({
    aid: site.stay22Aid,
    address,
    zoom: '18',
    viewmode: 'listview',
    limit: '5',
    campaign: 'lab-hotel-photos',
    maincolor: '1c2633',
    ...extra,
  }).toString()}`;
const B = { hotelsapi: 'booking', hidesearchbar: 'true', hidefilters: 'true', hidemodeswitcher: 'true' };
---
<Layout title="Test: hotel photos from Stay22" description="Internal test page." noindex>
  <div class="wrap">
    <h1>Test: Acropolis hotels</h1>
    <p class="dek measure">For each hotel, version A (as on the site now) and version B (Booking hotels only, no search bar). Which one shows this hotel first?</p>
    {rows.map((r) => (
      <section class="row">
        <h2>{r.name}</h2>
        <p class="small">{r.address}</p>
        <div class="pair">
          <div><p class="small">A</p><iframe src={make(r.address, {})} title={`A: ${r.name}`} loading="lazy"></iframe></div>
          <div><p class="small">B</p><iframe src={make(r.address, B)} title={`B: ${r.name}`} loading="lazy"></iframe></div>
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .row {
    margin-top: 40px;
  }
  .pair {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  iframe {
    display: block;
    width: 100%;
    height: 520px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky);
  }
  @media (max-width: 760px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
